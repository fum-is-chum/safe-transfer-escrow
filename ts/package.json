{
  "name": "safe-transfer-escrow-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the safe_transfer_escrow Sui Move package",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "codegen": "sui-ts-codegen generate",
    "build": "tsup",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json && tsc -p web/tsconfig.json && tsc -p publish/tsconfig.json",
    "test": "pnpm typecheck && vitest run",
    "test:watch": "vitest",
    "example": "tsx examples/index.ts",
    "publish-package": "tsx publish/publish.ts",
    "upgrade-package": "tsx publish/upgrade.ts",
    "web:dev": "vite web",
    "web:build": "vite build web"
  },
  "peerDependencies": {
    "@mysten/sui": "^2.23.0"
  },
  "devDependencies": {
    "@mysten/codegen": "0.12.24",
    "@mysten/dapp-kit-react": "^2.1.45",
    "@mysten/sui": "2.39.1",
    "@scallop-io/sui-kit": "3.0.0",
    "@scallop-io/sui-package-kit": "2.0.0",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dotenv": "^18.0.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^8.3.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vitest": "^4.1.11"
  }
}
