# Move build output.
# ⚠️ `/**/build` is what actually ignores `contracts/*/build/`. Keep the glob —
# a bare `/build` would only match the repo root and would start committing
# compiled bytecode.
/**/build

# Deployment artefacts, written per environment.
object-ids.json
object-ids.*.json
publish-result.*.json

# Secrets. Never commit a key or an environment file.
.env
.env*.local
*.pem
*.key

# Editors and OS noise
.idea
.vscode
.DS_Store

# Logs
*.log*

traces/
# Generated by `sui move summary`, input to ts/ codegen.
/package_summaries

# TS SDK
ts/node_modules
ts/dist
ts/web/dist

.coverage_map.mvcov